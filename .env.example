NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Who may use this deployment, comma separated. Leave empty to allow any login.
ALLOWED_EMAILS=
# Server only: used by the scheduled publisher to read every workspace's queue.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
CREDENTIALS_KEY=
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Public URL of this app, used to build OAuth redirect URIs, e.g. https://ctrlaltsocials.vercel.app
APP_URL=
# Threads: Meta app with the Threads use case. Redirect URI: <APP_URL>/api/oauth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
# X: developer app with OAuth 2.0 (Web App, read and write). Callback: <APP_URL>/api/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Instagram: Meta app with "Instagram API with Instagram Login". Redirect: <APP_URL>/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Facebook Pages: Meta app with Facebook Login. Valid OAuth redirect: <APP_URL>/api/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# YouTube: Google Cloud OAuth client (Web application) with the YouTube Data API v3 enabled. Redirect: <APP_URL>/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok: developer app with Login Kit + Content Posting API (direct post). Redirect: <APP_URL>/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Reddit: app of type "web app" at reddit.com/prefs/apps. Redirect: <APP_URL>/api/oauth/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
